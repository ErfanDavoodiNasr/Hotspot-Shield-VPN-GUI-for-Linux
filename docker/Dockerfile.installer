# Clean Ubuntu image for installer validation (no secrets)
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    python3-tk \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . /src

# Fail if secrets were accidentally copied (build context should exclude them)
RUN if [ -d /src/.secrets ]; then echo "ERROR: .secrets leaked into image" >&2; exit 1; fi

# Defensive: Git may not preserve +x on all hosts; enforce executable bits in-image.
RUN chmod 0755 /src/install.sh /src/uninstall.sh \
    && test -x /src/install.sh \
    && test -x /src/uninstall.sh

CMD ["./install.sh", "--yes"]
