# Live VPN validation image (amd64). Secrets must be mounted at runtime — never baked in.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    python3-tk \
    ca-certificates \
    curl \
    iproute2 \
    iptables \
    libdbus-1-3 \
    dbus \
    sudo \
    && rm -rf /var/lib/apt/lists/*

# Vendor CLI (amd64)
COPY hotspotshield_1.0.7_amd64.deb /tmp/hotspotshield.deb
RUN dpkg -i /tmp/hotspotshield.deb || true \
    && apt-get update && apt-get install -y -f --no-install-recommends \
    && rm -f /tmp/hotspotshield.deb

# Unprivileged user required by Hotspot Shield CLI
RUN useradd -m -s /bin/bash hsuser \
    && mkdir -p /app \
    && chown -R hsuser:hsuser /app

WORKDIR /app
COPY --chown=hsuser:hsuser pyproject.toml README.md ./
COPY --chown=hsuser:hsuser src ./src
COPY --chown=hsuser:hsuser tests ./tests
COPY --chown=hsuser:hsuser scripts ./scripts

USER hsuser
RUN python3 -m venv /home/hsuser/venv \
    && /home/hsuser/venv/bin/pip install --upgrade pip \
    && /home/hsuser/venv/bin/pip install -e ".[dev]"

ENV PATH="/home/hsuser/venv/bin:${PATH}"

# Refuse to build if secrets leaked into context
USER root
RUN test ! -e /app/.secrets
USER hsuser

CMD ["pytest", "-m", "live", "-vv"]
