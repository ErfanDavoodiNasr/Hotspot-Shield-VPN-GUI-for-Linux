# Live VPN validation image (amd64). Secrets must be mounted at runtime — never baked in.
# Uses the STABLE vendor channel (1.0.7), never the experimental WireGuard test build.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    python3-tk \
    ca-certificates \
    curl \
    iproute2 \
    iptables \
    libdbus-1-3 \
    libnl-3-200 \
    libnl-genl-3-200 \
    libnl-route-3-200 \
    dbus \
    sudo \
    && rm -rf /var/lib/apt/lists/*

# Download + verify stable Hotspot Shield CLI from the official HTTPS repo (no curl|bash).
COPY packaging/vendor_manifest.json /tmp/vendor_manifest.json
RUN python3 - <<'PY'
import hashlib, json, ssl, urllib.request
from pathlib import Path
manifest = json.loads(Path("/tmp/vendor_manifest.json").read_text())
pkg = next(p for p in manifest["channels"]["stable"]["packages"] if p["type"] == "deb")
url, expected, max_bytes = pkg["url"], pkg["sha256"].lower(), int(pkg["max_bytes"])
assert url.startswith("https://repo.hotspotshield.com/")
req = urllib.request.Request(url, headers={"User-Agent": "hotspotshield-gui-docker/1.0"})
with urllib.request.urlopen(req, timeout=120, context=ssl.create_default_context()) as resp:
    assert resp.status == 200
    data = resp.read(max_bytes + 1)
assert len(data) <= max_bytes
digest = hashlib.sha256(data).hexdigest()
assert digest == expected, (digest, expected)
Path("/tmp/hotspotshield.deb").write_bytes(data)
print("verified", digest)
PY
RUN dpkg -i /tmp/hotspotshield.deb || true \
    && apt-get update && apt-get install -y -f --no-install-recommends \
    && rm -f /tmp/hotspotshield.deb \
    && dpkg -l hotspotshield | grep -E '^ii' \
    && (hotspotshield version || true) \
    && test -x /usr/bin/hotspotshield

# Unprivileged user required by Hotspot Shield CLI
RUN useradd -m -s /bin/bash hsuser \
    && mkdir -p /app \
    && chown -R hsuser:hsuser /app

WORKDIR /app
COPY --chown=hsuser:hsuser pyproject.toml README.md ./
COPY --chown=hsuser:hsuser src ./src
COPY --chown=hsuser:hsuser tests ./tests
COPY --chown=hsuser:hsuser scripts ./scripts

USER hsuser
RUN python3 -m venv /home/hsuser/venv \
    && /home/hsuser/venv/bin/pip install --upgrade pip \
    && /home/hsuser/venv/bin/pip install -e ".[dev]"

ENV PATH="/home/hsuser/venv/bin:${PATH}"

# Refuse to build if secrets leaked into context
USER root
RUN test ! -e /app/.secrets
USER hsuser

CMD ["pytest", "-m", "live", "-vv"]
